# Ignore everything in /results/ EXCEPT explicitly named runs created
# via `traces run is --run-id NAME`, which land in /results/is/runs/.
# The trailing `/**` overrides the global `*.json` / `*.csv` / `*.pdf` rules
# above for files inside named-run directories.
/results/*
!/results/is/
/results/is/*
!/results/is/runs/
!/results/is/runs/**
intellicat-deploy
/.junie/
/.tmp/
