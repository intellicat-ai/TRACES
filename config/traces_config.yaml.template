scoring:
  short_response_threshold: 800
  intro_char_fallback: 500
  edi:
    level_ratios:
      1: 0.25
      2: 0.5
      3: 1.0
    length_gate_chars: 200

audit:
  provider: openrouter
  judge_model: "anthropic/claude-opus-4.6"
  proposer_model: "anthropic/claude-opus-4.6"
  temperature: 0.0
  top_p: 0.95
  max_tokens: 8192
  reasoning_effort: null
  parse_retries: 1

calibration:
  judge_models:
    - "anthropic/claude-opus-4.6"
    - "openai/gpt-5.4"
    - "qwen/qwen3.6-plus"

reporting:
  output_dir: "results/"
  plot_format: "png"
  plot_dpi: 150